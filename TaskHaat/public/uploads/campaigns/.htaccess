Options -Indexes -ExecCGI
<IfModule mod_mime.c>
  RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh
</IfModule>
<IfModule mod_authz_core.c>
  <FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
