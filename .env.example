# Copy this file to .env and update the values for your environment.
# Never commit .env or expose it through the public web root.
APP_NAME=TaskHaat
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Dhaka
# Local-only compatibility key. Keep this exact value for the existing local database.
# Before a fresh production launch, replace it with a unique key generated using:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Never change APP_KEY after encrypted payout references exist without re-encrypting them.
APP_KEY=taskhaat-local-development-key-change-before-deployment

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taskhaat
DB_USER=root
DB_PASS=
DB_TIMEZONE_OFFSET=+06:00

MAX_UPLOAD_BYTES=5242880
